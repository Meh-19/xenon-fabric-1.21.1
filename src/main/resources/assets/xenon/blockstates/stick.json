{
  "multipart": [
    {
      "when": { "facing": "north" },
      "apply": [
        { "model": "xenon:block/stick_0", "weight": 1 },
        { "model": "xenon:block/stick_1", "weight": 1 },
        { "model": "xenon:block/stick_2", "weight": 1 },
        { "model": "xenon:block/stick_3", "weight": 1 }
      ]
    },
    {
      "when": { "facing": "east" },
      "apply": [
        { "model": "xenon:block/stick_0", "y": 90, "weight": 1 },
        { "model": "xenon:block/stick_1", "y": 90, "weight": 1 },
        { "model": "xenon:block/stick_2", "y": 90, "weight": 1 },
        { "model": "xenon:block/stick_3", "y": 90, "weight": 1 }
      ]
    },
    {
      "when": { "facing": "south" },
      "apply": [
        { "model": "xenon:block/stick_0", "y": 180, "weight": 1 },
        { "model": "xenon:block/stick_1", "y": 180, "weight": 1 },
        { "model": "xenon:block/stick_2", "y": 180, "weight": 1 },
        { "model": "xenon:block/stick_3", "y": 180, "weight": 1 }
      ]
    },
    {
      "when": { "facing": "west" },
      "apply": [
        { "model": "xenon:block/stick_0", "y": 270, "weight": 1 },
        { "model": "xenon:block/stick_1", "y": 270, "weight": 1 },
        { "model": "xenon:block/stick_2", "y": 270, "weight": 1 },
        { "model": "xenon:block/stick_3", "y": 270, "weight": 1 }
      ]
    }
  ]
}
